[gd_resource type="Resource" script_class="LayerDef" load_steps=2 format=3]
[ext_resource path="res://src/domain/layer_def.gd" type="Script" id="1"]
[resource]
script = ExtResource("1")
id = &"layer_mech"
name_key = &"layer.mech.name"
description_key = &"layer.mech.description"
first_seed = 310307
entry_room_id = &"room_mech_entry"
normal_room_ids = Array[StringName]([&"room_mech_polarity", &"room_mech_logic"])
risk_room_ids = Array[StringName]([&"room_mech_saw", &"room_mech_sentinel", &"room_mech_warden"])
supply_room_id = &"room_mech_supply"
relic_room_id = &"room_mech_relic"
core_room_id = &"room_mech_core"
min_main_nodes = 10
max_main_nodes = 10
min_risk_branches = 2
max_risk_branches = 3
extra_relic_rooms = 1

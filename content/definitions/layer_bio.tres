[gd_resource type="Resource" script_class="LayerDef" load_steps=2 format=3]
[ext_resource path="res://src/domain/layer_def.gd" type="Script" id="1"]
[resource]
script = ExtResource("1")
id = &"layer_bio"
name_key = &"layer.bio.name"
description_key = &"layer.bio.description"
first_seed = 240203
entry_room_id = &"room_bio_entry"
normal_room_ids = Array[StringName]([&"room_bio_garden", &"room_bio_pulse"])
risk_room_ids = Array[StringName]([&"room_bio_spore", &"room_bio_vine_well", &"room_bio_manta"])
supply_room_id = &"room_bio_supply"
relic_room_id = &"room_bio_relic"
core_room_id = &"room_bio_core"
min_main_nodes = 9
max_main_nodes = 10
min_risk_branches = 2
max_risk_branches = 2
